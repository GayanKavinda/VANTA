QMainWindow {
    background: #FFFFFF;
}

QWidget {
    color: #111217;
    font-family: "Segoe UI", "SF Pro", Arial, sans-serif;
}

QLabel {
    color: #111217;
}

QPushButton {
    background: #111217;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background: #000000;
}

QPushButton:pressed {
    background: #CCCCCC;
}

QLineEdit {
    background: #FFFFFF;
    border: 1px solid #D0D2DA;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    color: #111217;
}

QLineEdit:focus {
    border: 1px solid #4A4A6A;
}

QFrame#sidebar {
    background: #F2F3F5;
}

QFrame#sidebar QPushButton {
    background: transparent;
    color: #5A5A66;
    border: none;
    padding: 0;
    font-weight: 400;
}

QFrame#sidebar QPushButton:hover {
    color: #111217;
    background: transparent;
}

QStackedWidget {
    background: #FFFFFF;
}

QComboBox {
    background: #FFFFFF;
    border: 1px solid #D0D2DA;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #111217;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
}

QCheckBox {
    font-size: 13px;
    color: #111217;
}

QSpinBox {
    background: #FFFFFF;
    border: 1px solid #D0D2DA;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 13px;
    color: #111217;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    border-left: 1px solid #D0D2DA;
}

QScrollArea {
    border: none;
}

QFrame#settings_section {
    background: #F2F3F5;
    border-radius: 12px;
}

QFrame#download_card {
    background: #F2F3F5;
    border: 1px solid #D0D2DA;
    border-radius: 12px;
}

QFrame#resource_row {
    background: #F2F3F5;
    border: 1px solid #D0D2DA;
    border-radius: 10px;
}

QFrame#resource_row:hover {
    border: 1px solid #A0A2B0;
}

QFrame#empty_state {
    background: transparent;
    border: 1px dashed #D0D2DA;
    border-radius: 12px;
}

QFrame#error_state {
    background: #FDECEA;
    border: 1px solid #E0A0A6;
    border-radius: 12px;
}

QLabel#empty_state_title {
    color: #111217;
    font-size: 15px;
    font-weight: 600;
}

QLabel#empty_state_body {
    color: #5A5A66;
    font-size: 13px;
}

QLabel#error_state_title {
    color: #C0392B;
    font-size: 15px;
    font-weight: 600;
}

QLabel#error_state_body {
    color: #A04040;
    font-size: 13px;
}

QLabel#section_title {
    color: #111217;
    font-size: 16px;
    font-weight: 600;
}

QLabel#section_meta {
    color: #5A5A66;
    font-size: 13px;
}

QLabel#resource_name {
    color: #111217;
    font-size: 14px;
    font-weight: 600;
}

QLabel#resource_meta {
    color: #5A5A66;
    font-size: 12px;
}

QLabel#resource_size {
    color: #6A6B75;
    font-size: 12px;
    font-weight: 600;
}

QLabel#confidence_high {
    color: #5AC8FA;
    background-color: rgba(90, 200, 250, 0.10);
    padding: 2px 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#confidence_medium {
    color: #F0C674;
    background-color: rgba(240, 198, 116, 0.15);
    padding: 2px 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#confidence_low {
    color: #6A6B75;
    background-color: rgba(150, 150, 160, 0.12);
    padding: 2px 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#confidence_rejected {
    color: #FF8585;
    background-color: rgba(255, 107, 107, 0.12);
    padding: 2px 8px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#secondary {
    background: transparent;
    color: #111217;
    border: 1px solid #D0D2DA;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton#secondary:hover {
    background: #E5E6EA;
    border: 1px solid #A0A2B0;
}

QPushButton#secondary:disabled {
    color: #A0A2B0;
    border: 1px solid #E5E6EA;
}

QPushButton#secondary[size="small"] {
    padding: 4px 10px;
    font-size: 12px;
}

QPushButton#primary_action[size="small"] {
    padding: 4px 10px;
    font-size: 12px;
}

QCheckBox {
    font-size: 13px;
    color: #111217;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #A0A2B0;
    border-radius: 4px;
    background: #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 1px solid #5AC8FA;
}

QCheckBox::indicator:checked {
    background: #5AC8FA;
    border: 1px solid #5AC8FA;
}

QProgressBar {
    background: #E5E6EA;
    border: none;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background: #111217;
    border-radius: 3px;
}

.warning-label {
    color: #FFD83D;
}

.error-label {
    color: #FF6B6B;
}

QHeaderView {
    color: #5A5A66;
}

QTableWidget {
    background: transparent;
    border: none;
    gridline-color: #D0D2DA;
}

QTableWidget::item {
    border-bottom: 1px solid #D0D2DA;
}

QTableWidget::item:selected {
    background: #E5E6EA;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #D0D2DA;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #A0A2B0;
}