QMainWindow {
    background: #0F1014;
}

QWidget {
    color: #E8E8EA;
    font-family: "Segoe UI", "SF Pro", Arial, sans-serif;
}

QLabel {
    color: #E8E8EA;
}

QPushButton {
    background: #E8E8EA;
    color: #111217;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background: #FFFFFF;
}

QPushButton:pressed {
    background: #DDDDDD;
}

QLineEdit {
    background: #17181E;
    border: 1px solid #292B33;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    color: #E8E8EA;
}

QLineEdit:focus {
    border: 1px solid #4A4A6A;
}

QFrame#sidebar {
    background: #111217;
}

QFrame#sidebar QPushButton {
    background: transparent;
    color: #8A8A9A;
    border: none;
    padding: 0;
    font-weight: 400;
}

QFrame#sidebar QPushButton:hover {
    color: #E8E8EA;
    background: transparent;
}

QStackedWidget {
    background: #0F1014;
}

QComboBox {
    background: #17181E;
    border: 1px solid #292B33;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #E8E8EA;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
}

QCheckBox {
    font-size: 13px;
    color: #E8E8EA;
}

QSpinBox {
    background: #17181E;
    border: 1px solid #292B33;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 13px;
    color: #E8E8EA;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: transparent;
    border: none;
    border-left: 1px solid #292B33;
}

QScrollArea {
    border: none;
}

QFrame#settings_section {
    background: #111217;
    border-radius: 12px;
}

QFrame#download_card {
    background: #111217;
    border: 1px solid #1A1B20;
    border-radius: 12px;
}

QProgressBar {
    background: #1A1B20;
    border: none;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background: #E8E8EA;
    border-radius: 3px;
}

.warning-label {
    color: #FFD83D;
}

.error-label {
    color: #FF6B6B;
}

QHeaderView {
    color: #8A8A9A;
}

QTableWidget {
    background: transparent;
    border: none;
    gridline-color: #1A1B20;
}

QTableWidget::item {
    border-bottom: 1px solid #1A1B20;
}

QTableWidget::item:selected {
    background: #17181E;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #292B33;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #3A3C4A;
}
